{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stardew Sync",
  "version": "0.1.0",
  "identifier": "com.bazq.stardewsync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stardew Sync",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MTA0RkZCN0ZBM0Y2NTEKUldSUjlxTi8rMDhRMlhpL3ZrSGRBVmYrblZPcERMNUVqQWpSOWdENElSUEtOYWQxRlhQMDAzSFQK",
      "endpoints": [
        "https://github.com/bazq3/stardew-sync-p2p/releases/latest/download/latest.json"
      ]
    }
  }
}
